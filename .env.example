# ─────────────────────────────────────────────────────────────────────────────
# OpenCode Telegram Bot — configuration
# Copy this file to .env and fill in the values, or run:  npm run setup
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — Telegram bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# RECOMMENDED — comma-separated Telegram user IDs allowed to use the bot.
# Get yours from @userinfobot. If empty, ANYONE can use the bot (unsafe).
ALLOWED_USERS=

# Path to the opencode binary. Leave blank to use "opencode" from PATH.
# Windows example: C:\Users\you\AppData\Roaming\npm\opencode.cmd
OPENCODE_PATH=

# Default workspace directory used when you start without picking a project.
# Defaults to the current working directory.
OPENCODE_WORKSPACE=

# Optional custom OpenCode agent name (from .opencode/agents/*.md).
# OPENCODE_AGENT=

# Auto-approve all tool calls so they run without prompts.
# Set to false to get inline Approve/Deny buttons in Telegram before OpenCode
# runs risky tools (file writes, shell commands).
OPENCODE_TRUST_ALL_TOOLS=true

# Comma-separated roots the /projects browser is allowed to list.
# Supports ~ for home directory. Defaults to OPENCODE_WORKSPACE's parent + home.
# Example: H:\Lucru\Domains,C:\Lucru\Domains
PROJECT_ROOTS=

# ── Rendering / streaming ────────────────────────────────────────────────────
# How often (ms) to edit the streaming message while the agent is typing.
STREAM_THROTTLE_MS=1500

# Coalesce rapid consecutive text messages into a single prompt.
MESSAGE_BATCH_MS=800

# Show tool-call status messages (file reads/writes, commands). true/false
SHOW_TOOL_CALLS=true

# Show unified diffs for file edits. true/false
SHOW_EDIT_DIFFS=true

# Max lines of a diff to show inline before truncating.
DIFF_MAX_LINES=120

# Send images the agent produces this turn back to Telegram automatically.
SEND_AGENT_IMAGES=true
AGENT_IMAGES_MAX=8

# File attachments. Non-image documents are read and inlined into the prompt.
DOC_MAX_CHARS=100000

# Show subagent activity while the main agent waits on its subagents.
SHOW_SUBAGENTS=true

# Task-progress bar.
SHOW_PROGRESS=true
PROGRESS_FALLBACK=true

# Deliver a session's "Done" summary even while that session is in the background.
NOTIFY_OTHER_SESSIONS=true

# ── MCP servers (/mcp) ───────────────────────────────────────────────────────
# MCP_PROBE_TIMEOUT_MS=8000
# MCP_PROBE_CONCURRENCY=6

# Auto-update (default on): check npm for a newer version when idle.
AUTO_UPDATE=true
# UPDATE_CHECK_MS=3600000

# Log level: debug | info | warn | error
LOG_LEVEL=info

# ── Daemon / background service ──────────────────────────────────────────────
# Auto-restart the OpenCode server with backoff if it exits.
OPENCODE_AUTO_RESTART=true

# Quiet mode (default true): send all messages silently.
QUIET_NOTIFICATIONS=true

# Give up on a running turn only after this many ms with NO streaming activity.
# PROMPT_IDLE_TIMEOUT_MS=900000

# Auto-retry a prompt up to N times on transient errors.
# PROMPT_RETRY_ATTEMPTS=5

# Auto-fork the session when retries are exhausted on a transient error.
# AUTO_FORK_ON_ERROR=true
# AUTO_FORK_CONTEXT_PCT=85

# Resume on stream error instead of failing.
# RESUME_ON_STREAM_ERROR=true

# Where to write the log file. Defaults to <project>/logs/opencode-telegram-bot.log
# LOG_DIR=
# LOG_FILE=

# ── Voice messages (speech-to-text) ──────────────────────────────────────────
# STT_API_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1
# STT_LANGUAGE=
